rules_version = '2';
// ============================================================================
//  REGOLE DI SICUREZZA  ·  Le Stanze di Ricci · Pulizie
//  Si incollano nella console Firebase: Firestore Database → Regole → Pubblica.
//
//  In parole semplici:
//   - chi non è entrato non vede niente;
//   - il ruolo di ognuno sta nella raccolta "ruoli" (un documento per email; lo scrivono solo i proprietari);
//   - le SIGNORE vedono solo le pulizie e i pagamenti della LORO zona e possono
//     cambiare SOLO lo stato di una pulizia (fatta / non fatta / problema + nota);
//   - i PROPRIETARI possono leggere e scrivere tutto;
//   - "lettura" vede tutto ma non cambia niente;
//   - il PONTE WhatsApp (ruolo "ponte", un utente tutto suo creato dall'app) può SOLO aggiungere i messaggi
//     del gruppo nella "posta" di Sofia e dire che è acceso; non legge e non cambia nient'altro.
// ============================================================================
service cloud.firestore {
  match /databases/{db}/documents {

    function entrato() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    // Proprietari "di sicurezza": entrano sempre, anche se la raccolta "ruoli" fosse vuota
    function proprietarioBase() {
      return entrato() && email() in [
        "michele@stanzericci.app", "papa@stanzericci.app", "mamma@stanzericci.app", "michelesantucci@stanzericci.app"
      ];
    }
    function haScheda() { return entrato() && exists(/databases/$(db)/documents/ruoli/$(email())); }
    function scheda() { return get(/databases/$(db)/documents/ruoli/$(email())).data; }
    function ruolo() { return haScheda() ? scheda().ruolo : (proprietarioBase() ? "proprietario" : ""); }
    function proprietario() { return ruolo() == "proprietario"; }
    function puoLeggereTutto() { return ruolo() == "proprietario" || ruolo() == "lettura"; }
    function addetta() { return ruolo() == "addetta"; }
    function ponte() { return ruolo() == "ponte"; }
    function miaZona() { return scheda().zona; }
    // La controllatrice di turno (scritta dai proprietari in impostazioni/controlli)
    function sonoControllatrice() {
      return addetta()
        && exists(/databases/$(db)/documents/impostazioni/controlli)
        && get(/databases/$(db)/documents/impostazioni/controlli).data.attuale == miaZona();
    }

    // Chi è chi (nome, ruolo, zona): un documento per indirizzo email.
    // Ognuno legge la propria scheda; i proprietari leggono e scrivono tutte.
    match /ruoli/{indirizzo} {
      allow read: if entrato() && (indirizzo == email() || puoLeggereTutto());
      allow write: if proprietario();
    }

    // Impostazioni: camere e regole le leggono tutti quelli entrati; il listino solo proprietari/lettura.
    match /impostazioni/{doc} {
      allow read: if entrato() && (doc != "listino" || puoLeggereTutto());
      allow write: if proprietario();
    }

    // Prospetto (chi dorme dove) e note: solo proprietari (e lettura).
    match /soggiorni/{id} {
      allow read: if puoLeggereTutto();
      allow write: if proprietario();
    }
    match /note/{id} {
      allow read: if puoLeggereTutto();
      allow write: if proprietario();
    }
    match /importazioni/{id} {
      allow read, write: if proprietario();
    }

    // Pagamenti: le signore vedono solo quelli della loro zona.
    match /pagamenti/{id} {
      allow read: if puoLeggereTutto() || (addetta() && resource.data.zona == miaZona());
      allow write: if proprietario();
    }

    // Pulizie: le signore vedono la loro zona e cambiano SOLO stato, ora, nota, settimana, segnatoDa, foto, stelle fatte, righe spuntate e non fatte.
    // La controllatrice di turno vede anche le camere FATTE dalle colleghe (per dare il voto).
    match /pulizie/{id} {
      allow read: if puoLeggereTutto()
        || (addetta() && resource.data.zona == miaZona())
        || (resource.data.stato == "fatta" && sonoControllatrice());
      allow create, delete: if proprietario();
      allow update: if proprietario()
        || (addetta()
            && resource.data.zona == miaZona()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stato", "ora", "inizio", "nota", "settimana", "segnatoDa", "foto", "rifiniture", "extraRifiniture", "spuntate", "nonFatte"])
            && request.resource.data.stato in ["da_fare", "in_corso", "fatta", "non_fatta", "problema"]);
    }

    // Controlli tra colleghe: la controllatrice dà il voto alle camere delle ALTRE zone;
    // i proprietari aggiungono il loro controllo. Ognuna vede i voti che riguardano la sua zona.
    match /controlli/{id} {
      allow read: if puoLeggereTutto()
        || (addetta() && (resource.data.zonaControllata == miaZona() || resource.data.zonaControllatrice == miaZona()));
      allow create: if proprietario()
        || (sonoControllatrice()
            && request.resource.data.zonaControllatrice == miaZona()
            && request.resource.data.zonaControllata != miaZona()
            && !("votoProprietario" in request.resource.data));
      allow update: if proprietario()
        || (sonoControllatrice()
            && resource.data.zonaControllatrice == miaZona()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["voto", "punti", "nota", "ora", "controllatrice", "settimana", "richieste", "nonFatte"]));
      allow delete: if proprietario();
    }

    // Lavori di manutenzione (problemi segnalati + lavori aggiunti a mano): li vedono e li chiudono i proprietari;
    // le signore possono solo AGGIUNGERE una voce per la loro zona (succede da sola quando segnalano un problema).
    match /manutenzione/{id} {
      allow read: if puoLeggereTutto();
      allow create: if proprietario()
        || (addetta() && request.resource.data.zona == miaZona() && request.resource.data.stato == "aperto");
      allow update, delete: if proprietario();
    }

    // Registro della governante ("ultima volta fatto", una voce per lavoro+posto): le signore lo aggiornano
    // per la loro zona quando segnano fatto; i proprietari tutto.
    match /governante_registro/{id} {
      allow read: if puoLeggereTutto() || (addetta() && resource.data.zona == miaZona());
      allow create, update: if proprietario() || (addetta() && request.resource.data.zona == miaZona());
      allow delete: if proprietario();
    }

    // Foto dei problemi (piccole, dentro al database): le signore ne aggiungono solo per la loro zona.
    match /foto/{id} {
      allow read: if puoLeggereTutto() || (addetta() && resource.data.zona == miaZona());
      allow create, update: if proprietario()
        || (addetta() && request.resource.data.zona == miaZona() && request.resource.data.dati is string && request.resource.data.dati.size() < 400000);
      allow delete: if proprietario();
    }

    // Il ponte WhatsApp (1.0): un programmino sul PC che LEGGE SOLTANTO il gruppo "Albergo".
    // Ha un utente suo (ruolo "ponte"): vede solo la SUA scheda in "ponti" (i gruppi da leggere) e ci scrive
    // solo il suo "battito"; nella "posta" può solo AGGIUNGERE messaggi (non leggerli, cambiarli o cancellarli).
    // I proprietari vedono tutto, segnano letto e cancellano.
    match /ponti/{id} {
      allow read: if proprietario() || (ponte() && id == email().split("@")[0]);
      allow create, delete: if proprietario();
      allow update: if proprietario()
        || (ponte() && id == email().split("@")[0]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vivo", "stato", "contati", "numero", "versione", "gruppiVisti"]));
    }
    match /posta/{id} {
      allow read, update, delete: if proprietario();
      allow create: if ponte()
        && request.resource.data.keys().hasOnly(["chat", "gruppo", "chi", "mio", "ts", "data", "ora", "tipo", "testo", "didascalia", "durata", "mime", "media", "storico"])
        && request.resource.data.testo is string && request.resource.data.testo.size() < 8000;
    }
    match /posta_media/{id} {
      allow read, delete: if proprietario();
      allow create: if ponte()
        && request.resource.data.keys().hasOnly(["mime", "dati", "ts"])
        && request.resource.data.dati is string && request.resource.data.dati.size() < 1000000;
    }

    // Tutto il resto: chiuso.
    match /{altro=**} {
      allow read, write: if false;
    }
  }
}
